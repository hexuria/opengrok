root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Recovered vendor code and the byte-anchored renderer patch library must stay byte-stable.
[frontend/src/recovered/**]
insert_final_newline = unset
trim_trailing_whitespace = unset

[scripts/lib/router-renderer-patch.mjs]
trim_trailing_whitespace = unset
